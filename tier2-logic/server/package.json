{
  "name": "@glidepath/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "esbuild src/app/server.ts --bundle --platform=node --target=node22 --format=esm --external:pg-native --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@glidepath/api-contract": "workspace:*",
    "@glidepath/data-access": "workspace:*",
    "@glidepath/domain": "workspace:*",
    "@glidepath/spec": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.20",
    "nodemailer": "10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@glidepath/pg-local": "workspace:*",
    "@glidepath/testkit": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
