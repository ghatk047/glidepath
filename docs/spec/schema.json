 "views": {
  "v_inputs_resolved": "For (tenant, scenario): variable_def LEFT JOIN variable_value LEFT JOIN scenario_value chain (scenario -> parent -> tenant default). What the engine loads.",
  "v_dimension_members": "UNION of global members (canonical_pool, addr_tag, system dims), dimension_member, and line_item, with attrs as jsonb."
 },
 "validation_rules": [
  {
   "id": "VR01",
   "rule": "org.dom_share sums to 1 over vp for every domain except out_of_scope_memo (which sums to 0)",
   "severity": "error"
  },
  {
   "id": "VR02",
   "rule": "exactly one vp has org.ss_flag = 1 when g.chargeback_on = 1",
   "severity": "error"
  },
  {
   "id": "VR03",
   "rule": "org.usage_override sums to 1 when org.usage_override_on = 1",
   "severity": "error"
  },
  {
   "id": "VR04",
   "rule": "value within variable_def min/max",
   "severity": "warning (UI clamps sliders; import flags)"
  },
  {
   "id": "VR05",
   "rule": "lv.ms0 >= 0 (contractor T&M cost cannot exceed the SI pool)",
   "severity": "error"
  },
  {
   "id": "VR06",
   "rule": "lev.L09.split_sw + lev.L09.split_cloud <= 1",
   "severity": "error"
  },
  {
   "id": "VR07",
   "rule": "lev.L09.n <= portfolio.apps",
   "severity": "error"
  },
  {
   "id": "VR08",
   "rule": "lev.rr_check = 0 and vp.check = 0 (engine self-test)",
   "severity": "error"
  },
  {
   "id": "VR09",
   "rule": "every line_item.pool_id in canonical_pool; domain_key and vendor_key exist",
   "severity": "error"
  },
  {
   "id": "VR10",
   "rule": "corp inputs present for every year an expression uses",
   "severity": "error"
  }
 ]
}