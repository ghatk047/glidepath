{
 "spec_version": "1.0.0",
 "principles": [
  "Numbers live in variable_value / scenario_value, keyed by (var_key, member_key). Entity tables hold only structure and categories.",
  "Formulas live in node_def as data (expression strings). No airline-specific logic in code.",
  "Every tenant table has tenant_id with row-level security. Global tables (model_version, *_def, canonical_pool, lever_template) are shared and read-only to tenants.",
  "Every write goes through a changeset (UI edit, Excel import, solver, AI reconfiguration), giving audit, diff and undo.",
  "member_key is the comma-joined member ids in the variable's dims order ('' for scalars), e.g. 'pilots,fy27'."
 ],
 "tables": {
  "model_version": {
   "scope": "global",
   "columns": [
    {
     "name": "id",
     "type": "uuid",
     "constraints": "pk",
     "description": ""
    },
    {
     "name": "semver",
     "type": "text",
     "constraints": "unique",
     "description": "e.g. 1.0.0"
    },
    {
     "name": "status",
     "type": "enum(draft,published,retired)",
     "constraints": "",
     "description": ""
    },
    {
     "name": "notes",
     "type": "text",
     "constraints": "",
     "description": ""
    },
    {
     "name": "created_at",
     "type": "timestamptz",
     "constraints": "",
     "description": ""
    }
   ],
   "description": "A frozen set of dimension_def, variable_def, node_def. Tenants pin one; upgrades are explicit."
  },
  "dimension_def": {
   "scope": "global",
   "columns": [
    {
     "name": "model_version_id",
