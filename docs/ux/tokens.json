{
  "name": "glidepath",
  "version": "1.0",
  "themes": {
    "cruise": {
      "mode": "dark", "default": true,
      "color": {
        "ground": "#060a12", "aurora1": "#16365f", "aurora2": "#0c4450", "aurora3": "#4a2f19",
        "glass": "rgba(148,182,228,.055)", "glass2": "rgba(148,182,228,.10)", "glass3": "rgba(148,182,228,.16)",
        "glassLine": "rgba(196,222,255,.11)", "glassHi": "rgba(255,255,255,.13)",
        "ink": "#eaf1fb", "ink2": "#a8b8cd", "ink3": "#7d8ea6", "hair": "rgba(196,222,255,.09)",
        "accent": "#8ccbff", "accent2": "#4f9be8", "accentInk": "#04111f", "accentGlow": "rgba(140,203,255,.35)",
        "track": "rgba(148,182,228,.17)", "total": "rgba(148,182,228,.22)", "chartGrid": "rgba(196,222,255,.07)",
        "pos": "#3ddc97", "neg": "#ff7466", "warn": "#fab219",
        "series": ["#3987e5", "#d95926", "#199e70", "#9085e9", "#d55181"],
        "sequential": ["#26364d", "#2f5d93", "#5f9fe6"]
      },
      "shadow": "0 30px 70px -30px rgba(0,0,0,.75)", "noise": 0.05
    },
    "daylight": {
      "mode": "light",
      "color": {
        "ground": "#e8eef6", "aurora1": "#bcd4f2", "aurora2": "#c8e8e6", "aurora3": "#f5dcbd",
        "glass": "rgba(255,255,255,.50)", "glass2": "rgba(255,255,255,.66)", "glass3": "rgba(255,255,255,.82)",
        "glassLine": "rgba(255,255,255,.85)", "glassHi": "rgba(255,255,255,.95)",
        "ink": "#0a1525", "ink2": "#3f4f66", "ink3": "#5d6c82", "hair": "rgba(16,36,72,.09)",
        "accent": "#1667c0", "accent2": "#4f9be8", "accentInk": "#ffffff", "accentGlow": "rgba(22,103,192,.25)",
        "track": "rgba(16,36,72,.12)", "total": "#c3d0e2", "chartGrid": "rgba(16,36,72,.07)",
        "pos": "#0b8a54", "neg": "#cf3f33", "warn": "#a86a00",
        "series": ["#2a78d6", "#eb6834", "#1baf7a", "#6250d6", "#e87ba4"],
        "sequential": ["#c5d2e3", "#86b6ef", "#2a78d6"]
      },
      "shadow": "0 30px 60px -34px rgba(22,44,84,.35)", "noise": 0.035
    }
  },
  "type": {
    "families": { "ui": "Geist", "num": "Geist", "mono": "Geist Mono", "source": "Google Fonts (OFL)" },
    "scale": {
      "hero": { "size": "clamp(48px,5.4vw,76px)", "weight": 300, "tracking": "-0.035em" },
      "xl": { "size": "clamp(30px,3vw,40px)", "weight": 300, "tracking": "-0.03em" },
      "l": { "size": "22px", "weight": 400 }, "m": { "size": "15px", "weight": 400 },
      "s": { "size": "13px", "weight": 400 }, "xs": { "size": "11px", "weight": 500, "family": "mono", "case": "upper", "tracking": "0.09em" }
    },
    "numerals": "tabular-nums"
  },
  "radius": { "panel": 22, "card": 16, "control": 12, "small": 8, "pill": 999 },
  "space": { "gridColumns": 12, "gap": 18, "panelPad": "22px 24px", "railWidth": 84, "phoneGutter": 16 },
  "glass": { "blur": "28px", "saturate": "150%", "highlight": "inset 0 1px 0 glassHi", "border": "1px glassLine" },
  "motion": {
    "ease": "cubic-bezier(.2,.8,.2,1)", "spring": "cubic-bezier(.34,1.56,.64,1)",
    "value": "420ms", "roll": "520ms", "flash": "900ms", "stagger": "90ms", "toast": "2400ms", "skyDrift": "46-60s",
    "reducedMotion": "all off"
  },
  "breakpoints": { "tablet": 1180, "phone": 760 }
}
