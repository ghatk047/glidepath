# Glidepath settings. Copy to .env (git-ignored) and fill the empty secrets:
#   cp .env.example .env
# README "Running locally" has a one-liner that generates them. Every setting the stack
# reads is listed here (12-factor, docs/architecture/11_docker_deployment.md section 4).
# Empty means "use the default in the config loader". Nothing in this file is a real secret.
# Use URL-safe secrets (letters and digits, e.g. `openssl rand -hex 24`): the passwords are
# embedded in the database URLs below.

# ----------------------------------------------------------------------------- Compose
# dev adds mailpit, which catches magic-link emails at http://localhost:8025.
# On a host with a real mail server, empty this and point SMTP_URL at that server.
COMPOSE_PROFILES=dev
# Image tag for glidepath/logic and glidepath/web.
TAG=dev
# Host address web binds 80/443 to. 127.0.0.1 keeps the laptop off the LAN; 0.0.0.0 on a cloud VM.
WEB_BIND_ADDRESS=127.0.0.1
# Managed Postgres (Neon): uncomment, and set the two DATABASE_URLs below with ?sslmode=require.
# COMPOSE_FILE=docker-compose.yml:docker-compose.neon.yml

# ------------------------------------------------- Tier 3: local Postgres (db service only)
# Bootstrap superuser of the local container. Not used by tier 2; unused with Neon.
POSTGRES_PASSWORD=
# Passwords the init scripts give the roles glidepath_owner and glidepath_app.
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# ------------------------------------- Database for tier 2 (the ONLY DB settings it reads)
# App role, used by logic and worker at runtime (RLS applies). TLS comes from sslmode.
# Neon: postgresql://glidepath_app:<password>@<pooled-host>/glidepath?sslmode=require
DATABASE_URL=postgresql://glidepath_app:${APP_DB_PASSWORD}@db:5432/glidepath?sslmode=disable
# Owner role, used only by the migrate container.
# Neon: postgresql://glidepath_owner:<password>@<direct-host>/glidepath?sslmode=require
DATABASE_URL_MIGRATE=postgresql://glidepath_owner:${OWNER_DB_PASSWORD}@db:5432/glidepath?sslmode=disable

# --------------------------------------------------- Object store (objects service, S3 API)
# Empty uses the pinned MinIO-compatible image in docker-compose.yml. Keep any override
# pinned to a RELEASE tag or digest.
OBJECTS_IMAGE=
MINIO_ROOT_USER=glidepath
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://objects:9000
# Locally the app uses the object store's root credentials; with S3 or another store,
# put that store's access key pair here.
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# ------------------------------------------------------------------------- Auth and web
# Signs session cookies and magic-link tokens.
AUTH_SECRET=
# Where users open the app; also the site address Caddy serves (and gets a certificate for).
PUBLIC_BASE_URL=https://localhost
# Outgoing mail for magic links. smtp://mail:1025 is mailpit (dev profile).
SMTP_URL=smtp://mail:1025
# Minutes a magic link stays valid.
AUTH_LINK_TTL_MIN=
# Minutes of inactivity before a what-if session is closed (ADR-022).
SESSION_IDLE_MIN=
# Fictitious demo user the seed creates with an owner membership.
DEMO_USER_EMAIL=demo@example.com

# ------------------------------------------------------------------------- Jobs and AI
# Parallel jobs per worker process.
JOB_CONCURRENCY=
# Claude API key, read by the worker only. Leave empty to run without AI reconfiguration.
ANTHROPIC_API_KEY=
# Token budget per AI job (ADR-022).
AI_MAX_TOKENS_PER_JOB=

# ----------------------------------------------------------------------------- Logging
# trace | debug | info | warn | error
LOG_LEVEL=info
