# Glidepath settings. Copy to .env (git-ignored) and fill the empty secrets:
#   cp .env.example .env
# README "Running locally" has a one-liner that generates them. Every setting the stack
# reads is listed here (12-factor, docs/architecture/11_docker_deployment.md section 4).
# Empty means "use the default in the config loader". Nothing in this file is a real secret.
# Use URL-safe secrets (letters and digits, e.g. `openssl rand -hex 24`): the passwords are
# embedded in the database URLs below.

# ----------------------------------------------------------------------------- Compose
# dev and demo add mailpit, which catches magic-link emails at http://localhost:8025. demo is the Dec 4 stack:
# `ops/demo-pin.sh` sets it, with TAG and the digests below (README "Demo profile").
# On a host with a real mail server, empty this and point SMTP_URL at that server.
COMPOSE_PROFILES=dev
# Image tag for glidepath/logic and glidepath/web.
TAG=dev
# Digest pins, each empty or `@sha256:<64 hex>`, appended to the image reference. Empty in dev; the demo
# profile has all four set by ops/demo-pin.sh so the images cannot change under the demo.
LOGIC_IMAGE_PIN=
WEB_IMAGE_PIN=
DB_IMAGE_PIN=
MAIL_IMAGE_PIN=
# Optional digest pin of cloudflared (tunnel profile), set by hand: `docker image inspect --format '{{index .RepoDigests 0}}'`.
TUNNEL_IMAGE_PIN=
# Host address web binds 80/443 to. 127.0.0.1 keeps the laptop off the LAN; 0.0.0.0 on a cloud VM.
WEB_BIND_ADDRESS=127.0.0.1
# Managed Postgres (Neon): uncomment, and set the two DATABASE_URLs below with ?sslmode=require.
# COMPOSE_FILE=docker-compose.yml:docker-compose.neon.yml

# ------------------------------------------------- Tier 3: local Postgres (db service only)
# Bootstrap superuser of the local container. Not used by tier 2; unused with Neon.
POSTGRES_PASSWORD=
# Passwords the init scripts give the roles glidepath_owner and glidepath_app.
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# ------------------------------------- Database for tier 2 (the ONLY DB settings it reads)
# App role, used by logic and worker at runtime (RLS applies). TLS comes from sslmode.
# Neon: postgresql://glidepath_app:<password>@<pooled-host>/glidepath?sslmode=require
DATABASE_URL=postgresql://glidepath_app:${APP_DB_PASSWORD}@db:5432/glidepath?sslmode=disable
# Owner role, used only by the migrate container.
# Neon: postgresql://glidepath_owner:<password>@<direct-host>/glidepath?sslmode=require
DATABASE_URL_MIGRATE=postgresql://glidepath_owner:${OWNER_DB_PASSWORD}@db:5432/glidepath?sslmode=disable

# ------------------------------------------------------------------------- Object store
# Workbooks and AI audit files live in Postgres (ADR-025); there is no object-store service.
OBJECT_STORE=postgres

# ------------------------------------------------------------------------- Auth and web
# Signs session cookies and magic-link tokens.
AUTH_SECRET=
# Where users open the app; also the site address Caddy serves (and gets a certificate for).
PUBLIC_BASE_URL=https://localhost
# Outgoing mail for magic links. smtp://mail:1025 is mailpit (dev profile).
SMTP_URL=smtp://mail:1025
# Minutes a magic link stays valid.
AUTH_LINK_TTL_MIN=
# Minutes of inactivity before a what-if session is closed (ADR-022).
SESSION_IDLE_MIN=
# Largest Excel upload accepted, in bytes (default 10 MiB, capped at the 50 MiB object store limit).
IMPORT_MAX_BYTES=
# 1 (default) warms the solver result cache after the seed so the Cockpit loads instantly; 0 skips it.
WARM=1
# Fictitious demo user the seed creates with an owner membership.
DEMO_USER_EMAIL=demo@example.com

# ---------------------------------------------- Public demo: Cloudflare Tunnel and Access (OPS-09)
# ops/README.md "Public demo (Cloudflare)". Start: docker compose --profile demo --profile tunnel up -d
# Set PUBLIC_BASE_URL above to the public hostname (e.g. https://glidepath.example.org): it is Caddy's site address.
# Token of a dashboard-managed tunnel (Zero Trust > Networks > Tunnels > the tunnel > the install command's token),
# read by the `tunnel` service only. A secret: only in this .env, never in git. Not needed when cloudflared runs
# outside compose with a locally managed config.
# In the tunnel's Public hostname set: service https://web:443, Additional settings > TLS > Origin Server Name =
# the PUBLIC_BASE_URL host, No TLS Verify = on (Caddy serves its own `tls internal` certificate).
TUNNEL_TOKEN=
# Cloudflare Access team domain, e.g. icy-recipe-ffdf.cloudflareaccess.com (shown in Zero Trust > Settings as the
# team domain). With CF_ACCESS_AUD set, logic signs in whoever carries a valid Access JWT. Both empty = off.
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag of the Access application (Access > Applications > the app > Overview). Set it
# here only, on the machine that runs the stack.
CF_ACCESS_AUD=
# Tenant slugs an Access-verified user with no membership joins (default aa; `none` = no auto-membership).
ACCESS_AUTO_TENANTS=
# Role of those memberships: owner, editor, viewer or advisor (default editor).
ACCESS_AUTO_ROLE=
# Optional re-check of the address domain after Access, comma-separated (e.g. gmail.com,infosys.com). Access
# itself enforces the allowed domains; empty = no re-check.
ACCESS_ALLOWED_DOMAINS=

# ------------------------------------------------------------------------- Jobs and AI
# Parallel jobs per worker process.
JOB_CONCURRENCY=
# Pareto frontier queue (SRC-12). The compose worker defaults it to 1.
JOB_SOLVER_PARETO=1
# pg-boss schema of the job queue, shared by logic (sends jobs) and worker (default pgboss).
JOB_QUEUE_SCHEMA=
# How often logic polls solver runs to push WS `job` messages, in ms (default 250, clamped 50..400).
JOB_RELAY_POLL_MS=
# 0 (default): the AI reconfiguration feature is not part of this deployment; ops/demo-check.sh skips the UA draft
# check ("skipped (AI off)"). 1: it is, and demo-check requires the rehearsed UA draft (AI-07).
AI_ENABLED=0
# Claude API key, read by the worker only. Leave empty to run without AI reconfiguration.
ANTHROPIC_API_KEY=
# Optional AI overrides (defaults in tier2-logic/ai/README.md): model ids, base URL, limits.
AI_MODEL=
AI_MODEL_LIGHT=
ANTHROPIC_BASE_URL=
AI_MAX_OUTPUT_TOKENS=
AI_RETRY_ATTEMPTS=
AI_RETRY_BASE_MS=
AI_RETRY_MAX_MS=
AI_MAX_PAUSE_TURNS=
# Token budget per AI job (ADR-022).
AI_MAX_TOKENS_PER_JOB=

# ----------------------------------------------------------------------------- Logging
# trace | debug | info | warn | error
LOG_LEVEL=info
